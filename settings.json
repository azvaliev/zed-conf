// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "edit_predictions": {
    "disabled_globs": [".env", ".env.*", ".gitignore"],
    "mode": "eager",
    "enabled_in_text_threads": false,
  },
  "features": {
    "edit_prediction_provider": "zed",
  },
  "buffer_font_family": "SFMono Nerd Font",
  "auto_install_extensions": {
    "html": true,
    "sql": true,
    "templ": true,
    "oxc": true,
  },
  "theme": {
    "mode": "system",
    "dark": "GitHub Monochrome Dark",
    "light": "GitHub Monochrome Light",
  },
  "telemetry": {
    "diagnostics": false,
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": false,
      "update_debounce_ms": 2500,
      "padding": 4,
      "min_column": 0,
      "max_severity": "warning",
    },
  },
  "file_types": {
    "JSONC": [
      "**/.zed/**/*.json",
      "**/zed/**/*.json",
      "**/Zed/**/*.json",
      "**/.vscode/**/*.json",

      "**/project.json",
      "**/tsconfig.json",

      "**/.oxlintrc*.json",
      "**/.eslintrc*.json"
    ],
    "Shell Script": [".env.*"]
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "buffer_line_height": "standard",
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "never",
  },
  "vertical_scroll_margin": 10,
  "use_smartcase_search": true,
  "vim": {
    "use_smartcase_find": true,
    "use_system_clipboard": "always",
  },
  "project_panel": {
    "dock": "right",
    "git_status": false,
  },
  "tab_size": 2,
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 4000,
    },
  },
  "lsp": {
    "eslint": {
      "settings": {
        "onIgnoredFiles": "off",
      },
    },
    "oxlint": {
      "initialization_options": {
        "options": {
          "run": "onType",
          "configPath": null,
          "tsConfigPath": null,
          "unusedDisableDirectives": "allow",
          "typeAware": true,
        },
      },
    },
    "vtsls": {
      "settings": {
        "$schema": "https://raw.githubusercontent.com/yioneko/vtsls/refs/heads/main/packages/service/configuration.schema.json",
        "autoUseWorkspaceTsdk": true,
        "experimental": {
          "completion": {
            "enableServerSideFuzzyMatch": true,
            "entriesLimit": 100,
          },
        },
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 8192,
          },
        },
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 8192,
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": {
              "enabled": false,
            },
            "variableTypes": {
              "enabled": false,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": {
              "enabled": true,
            },
            "functionLikeReturnTypes": {
              "enabled": false,
            },
            "enumMemberValues": {
              "enabled": true,
            },
          },
          "preferences": {
            "autoImportFileExcludePatterns": [
              "**/build/**",
              "**/out/**",
              "**/*.test.ts",
              "**/*.spec.ts",
            ],
            "includeCompletionsForModuleExports": false,
            "includePackageJsonAutoImports": "off",
            "preferTypeOnlyAutoImports": true,
          },
        },
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": {
            "singleQuote": true,
          },
          "customTags": [
            // For gitlab
            "!reference sequence",
          ],
          "schemas": {
            "https://raw.githubusercontent.com/OAI/OpenAPI-Specification/refs/heads/main/schemas/v3.1/schema.yaml": [
              "openapi*.yml",
              "openapi*.yaml",
            ],
            "https://raw.githubusercontent.com/compose-spec/compose-spec/refs/heads/main/schema/compose-spec.json": [
              "docker-compose*.yml",
              "docker-compose*.yaml",
            ],
          },
        },
      },
    },
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": ["prettier"],
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": ["prettier"],
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": ["prettier"],
    },
  },
}
